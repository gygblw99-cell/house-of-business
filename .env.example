# ============================================================
#   House of Business — Environment Variables
#   Copy to .env and fill in all values.
#   NEVER commit .env to git.
# ============================================================

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://hob_user:CHANGE_ME@localhost:5432/house_of_business
DB_NAME=house_of_business
DB_USER=hob_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ── JWT ─────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Minimum 32 chars (dev), 64 chars (production)
JWT_SECRET=CHANGE_ME_RUN_node_e_crypto_randomBytes_64_toString_hex
JWT_EXPIRES_IN=7d
# Dedicated secret for QR clock-in tokens (decoupled from JWT signing)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QR_SECRET=CHANGE_ME_random_32_chars
# Dedicated key for AES-256 conversation/API-key encryption (decoupled from
# JWT_SECRET). Set once and never change unless you also wipe the encrypted
# data — rotating it makes previously-encrypted rows unreadable.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONVERSATION_ENCRYPT_KEY=CHANGE_ME_random_32_chars

# ── Server ──────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── CORS (comma-separated list of allowed origins) ──────────
ALLOWED_ORIGINS=http://localhost:3002,http://localhost:4000

# ── App URLs ────────────────────────────────────────────────
APP_URL=http://localhost:3002
BACKEND_URL=http://localhost:3001/api

# ── AI (Anthropic Claude) ────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── AI (Groq — free tier fallback) ──────────────────────────
GROQ_API_KEY=gsk_...

# ── AI (Google Gemini — free tier fallback) ─────────────────
GEMINI_API_KEY=AIza...

# ── Email (Resend) — REQUIRED for password reset, invites, payslips ──
# Raw SMTP/nodemailer is blocked outbound on Railway's network, so this is
# the path that actually works there. Get the key from resend.com → API Keys.
RESEND_API_KEY=re_...
# Must be on a domain verified in the Resend dashboard for real deliverability.
RESEND_FROM_EMAIL=House of Business <noreply@yourdomain.com>

# ── SMTP (optional — per-business Gmail sender for supplier-order /
#    price-comparison emails only; NOT used for the RESEND_* mail above) ──
SMTP_PORT=587

# ── Gmail OAuth (optional — Z-report / delivery email auto-import) ─
# From Google Cloud Console → APIs & Services → Credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3001/api/gmail/callback

# ── Billing (PAYPLUS) — optional, not currently in active use ───
# Degrades gracefully when unset (subscription endpoints return 503).
# Get both from the PayPlus dashboard → הגדרות → API Management.
# PAYPLUS_API_KEY=
# PAYPLUS_SECRET_KEY=

# ── SMS (Twilio) — optional ──────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+972...

# ── Push Notifications (Firebase Admin SDK) ──────────────────
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ── Redis (Cache) — optional, falls back to in-memory ────────
REDIS_URL=redis://localhost:6379

# ── Admin CSRF (production only) ─────────────────────────────
# URL of the admin panel — used for CSRF origin validation
ADMIN_ORIGIN=http://localhost:3002

# ── Error Monitoring (Sentry) ─────────────────────────────────
# Get DSN from: sentry.io → New Project → Node.js
SENTRY_DSN=
ERROR_WEBHOOK_URL=

# ── Supabase (optional — for file storage) ───────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ── Web (Next.js) ────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_PLATFORM_URL=http://localhost:3002

# ── Marketing Website ────────────────────────────────────────
NEXT_PUBLIC_WEBSITE_URL=http://localhost:4000
WEBSITE_URL=http://localhost:4000
# Shared secret between backend and the marketing website — triggers
# on-demand ISR revalidation when backend data changes. Must match on both.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=CHANGE_ME_random_32_chars
# Inbox that receives every lead submitted on the website contact form
LEAD_EMAIL=leads@yourdomain.com

# ── Automated DB Backups (docker-compose "backup" service) ───
# Cron schedule for pg_dump — see https://crontab.guru. Default: daily at 03:00.
BACKUP_SCHEDULE=0 3 * * *
# How many daily/weekly/monthly backups to keep before older ones are pruned
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_WEEKS=8
BACKUP_KEEP_MONTHS=6
