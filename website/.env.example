# House of Business — Marketing Website (port 4000)
# Copy to .env.local and fill in values

# Backend API URL — used for ISR public stats fetch
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Platform URL — used for login/register links
NEXT_PUBLIC_PLATFORM_URL=http://localhost:3002

# ISR revalidation secret — must match REVALIDATE_SECRET in backend .env
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=change_me_same_as_backend

# Contact-form leads — sent via Resend's HTTPS API (raw SMTP is blocked
# outbound on Railway's network, so this is required, not optional).
# Get the key from resend.com → API Keys.
RESEND_API_KEY=re_...
# Must be on a domain verified in the Resend dashboard for real deliverability
# (unset falls back to Resend's shared onboarding@resend.dev test address).
# RESEND_FROM_EMAIL="House of Business <leads@yourdomain.com>"
# REQUIRED — inbox that receives every lead submitted on the contact form.
LEAD_EMAIL=leads@yourdomain.com
