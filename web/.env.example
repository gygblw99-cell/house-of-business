# ═══════════════════════════════════════════════════════════════
#  House of Business — Web (Next.js) Environment Variables
#  Copy this file to .env.local and fill in all values
# ═══════════════════════════════════════════════════════════════

# ── API URL ────────────────────────────────────────────────────
# Local dev — Next.js proxy at /api-proxy forwards to localhost:3001
NEXT_PUBLIC_API_URL=/api-proxy

# Production — use the proxy path (BACKEND_URL handles the actual target)
# NEXT_PUBLIC_API_URL=/api-proxy

# ── Backend URL (server-side proxy target) ─────────────────────
# Used by app/api-proxy/[...path]/route.ts
# Local:       BACKEND_URL=http://localhost:3001/api
# Docker:      BACKEND_URL=http://backend:3001/api
# Production:  BACKEND_URL=http://backend:3001/api  (internal Docker network)
BACKEND_URL=http://localhost:3001/api

# ── Marketing website URL (public — used for privacy/terms links) ──
# Local:       NEXT_PUBLIC_WEBSITE_URL=http://localhost:4000
# Production:  NEXT_PUBLIC_WEBSITE_URL=https://YOUR_DOMAIN (or the Vercel URL)
NEXT_PUBLIC_WEBSITE_URL=http://localhost:4000

# ── Push Notifications (optional — Firebase Cloud Messaging) ────
# From Firebase Console → Project Settings → General / Cloud Messaging.
# Without these, usePushNotifications.ts silently no-ops (no crash).
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ── Error Monitoring (optional) ──────────────────────────────────
# NEXT_PUBLIC_SENTRY_DSN=
