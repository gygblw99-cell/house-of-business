# ═══════════════════════════════════════════════════════════════
#  House of Business — Backend Environment Variables
#  Copy this file to .env and fill in all values
#  Generate JWT_SECRET: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ═══════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────
# Local:      postgresql://postgres:password@localhost:5432/hob
# Production: postgresql://hob_user:[PASSWORD]@[HOST]:5432/house_of_business
DATABASE_URL=postgresql://postgres:password@localhost:5432/hob
DB_PASSWORD=change_me_strong_password

# ── Authentication ─────────────────────────────────────────────
# REQUIRED: Minimum 32 chars in dev, 64 chars in production
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_minimum_64_characters_long_random_string_here_REPLACE_THIS_NOW
# Dedicated secret for QR clock-in tokens (decoupled from JWT signing)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QR_SECRET=change_me_random_32_chars_minimum
# Dedicated key for AES-256-GCM conversation encryption (decoupled from JWT_SECRET).
# IMPORTANT: rotating JWT_SECRET WITHOUT setting this will make all saved conversation
# history unreadable. Set this once and never change it unless you also wipe ai_conversations.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CONVERSATION_ENCRYPT_KEY=change_me_random_32_chars_minimum

# ── AI Providers ───────────────────────────────────────────────
# Anthropic (Claude) — starts with sk-ant-
ANTHROPIC_API_KEY=sk-ant-...
# Google Gemini (optional fallback)
# GEMINI_API_KEY=
# Groq (optional — free/cheap tier for low-complexity AI calls, see aiOrchestrator.service.js)
# GROQ_API_KEY=
# SerpAPI — powers price-comparison web search (priceComparison.routes.js)
# SERP_API_KEY=
# OpenWeather — used for weather-aware demand forecasting
# OPENWEATHER_API_KEY=

# ── Gmail OAuth (optional — Z-report / delivery email auto-import) ─
# From Google Cloud Console → APIs & Services → Credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3001/api/gmail/callback
# Encrypts stored delivery-email IMAP passwords (AES-256). If unset, falls
# back to JWT_SECRET — set this separately to avoid coupling the two.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DELIVERY_EMAIL_ENC_KEY=

# ── Server ─────────────────────────────────────────────────────
# On Railway (or any platform that auto-assigns a port), leave this unset —
# the app already falls back to whatever $PORT the platform injects.
# Only set it explicitly for local dev / a bare-metal deploy behind your own
# reverse proxy, where you need a fixed, known port.
PORT=3001
NODE_ENV=development

# ── URLs (REQUIRED in production) ──────────────────────────────
# Public URL of the web app — used in email links (invite, password reset)
# Production: APP_URL=https://app.yourdomain.com
APP_URL=http://localhost:3002

# Internal URL of this backend — used by Guardian health checks
# In Docker: BACKEND_BASE_URL=http://backend:3001
# In production VM: BACKEND_BASE_URL=http://localhost:3001
BACKEND_BASE_URL=http://localhost:3001

# URL of the Next.js frontend — used by api-proxy
# Production: BACKEND_URL=http://backend:3001/api  (Docker internal)
BACKEND_URL=http://localhost:3001/api

# ── CORS ───────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
# REQUIRED in production
# Production: ALLOWED_ORIGINS=https://app.yourdomain.com,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:4000

# ── Billing (PAYPLUS) — optional, not currently in active use ───
# The billing routes degrade gracefully when these are unset (subscription
# endpoints return 503, IPN webhooks are rejected) — the server does NOT
# refuse to start without them. Set both once you're ready to take real
# recurring payments. Get both from the PayPlus dashboard → הגדרות → API Management.
# PAYPLUS_API_KEY=
# PAYPLUS_SECRET_KEY=

# ── Redis ──────────────────────────────────────────────────────
# If omitted, falls back to in-memory cache automatically
# Production: REDIS_URL=redis://:[PASSWORD]@[HOST]:6379
# REDIS_URL=

# ── Email (REQUIRED for password reset, employee invites, payslips) ─
# Sent via Resend's HTTPS API — raw SMTP/nodemailer is blocked outbound on
# Railway's network, so this is the only path that actually works there.
# Get the key from resend.com → API Keys.
RESEND_API_KEY=re_...
# Must be on a domain verified in the Resend dashboard for real deliverability
# (unset falls back to Resend's shared onboarding@resend.dev test address).
# RESEND_FROM_EMAIL="House of Business <noreply@yourdomain.com>"

# ── SMTP (optional — used only as the per-business Gmail sender for
#    supplier orders / price-comparison emails, e.g. business_email_configs;
#    NOT used for password reset/invites/payslips, see RESEND_* above) ──
# SMTP_PORT=587

# ── IMAP (optional — legacy per-business Z-report/delivery email polling,
#    superseded by Gmail OAuth above but still supported as a fallback) ──
# Defaults to imap.gmail.com / SMTP_USER+SMTP_PASSWORD if unset
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASSWORD=

# ── Push Notifications (optional) ──────────────────────────────
# Firebase Cloud Messaging
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_CLIENT_EMAIL=

# ── SMS / WhatsApp (optional) ──────────────────────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# ── Supabase (optional — for ai-analyze endpoint) ──────────────
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=

# ── Error Monitoring (optional) ────────────────────────────────
# Webhook URL for 500 errors — Sentry DSN or custom endpoint
# ERROR_WEBHOOK_URL=https://o123456.ingest.sentry.io/api/123456/store/
# Sentry project DSN (separate from the webhook above) — enables the
# @sentry/node integration in index.js for full error/performance tracking
# SENTRY_DSN=

# ── Guardian AI alert email (recommended) ───────────────────────
# Comma-separated email(s) that receive an alert when Guardian AI detects a
# critical/high severity incident. Falls back to querying admin_users for
# active super_admins if unset — but set this explicitly anyway: if the
# incident IS a full DB outage, that same DB query for recipients also
# fails, so this is the only path that still works during a total DB outage.
# ADMIN_ALERT_EMAIL=you@example.com

# ── Session length (optional) ───────────────────────────────────
# Login/admin-cookie expiry, e.g. '7d', '1h', '30m'. Defaults to 7d.
# JWT_EXPIRES_IN=7d

# ── POS integrations (optional — only needed if that POS brand is used) ─
# Both already default to the real vendor API if unset; override only for
# a sandbox/staging vendor endpoint.
# AVIV_API_URL=
# BIKOUM_API_URL=

# ── DB Backup Alerts (optional, PM2/bare-metal deploys only) ───
# scripts/backup_db.js posts here if a scheduled backup fails. Only relevant
# if you're running that script via PM2 cron (backend/ecosystem.config.js) —
# not used on Railway, which doesn't run this script at all.
# BACKUP_ALERT_WEBHOOK=

# ── Admin panel CSRF ───────────────────────────────────────────
# REQUIRED in production: full origin (scheme + host, no trailing slash) of the admin Next.js app
# Example: ADMIN_ORIGIN=https://admin.yourdomain.com
ADMIN_ORIGIN=http://localhost:3002

# ── Admin DB ───────────────────────────────────────────────────
# PG_ADMIN_PASS=change_me_strong_password

# ── Marketing Website ISR Revalidation ─────────────────────────
# Shared secret between backend and the marketing website (port 4000)
# Used to trigger on-demand ISR revalidation when backend data changes
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REVALIDATE_SECRET=change_me_random_32_chars
# Internal URL of the marketing website
# WEBSITE_URL=http://localhost:4000
